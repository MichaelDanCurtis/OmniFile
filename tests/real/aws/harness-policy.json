{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamReadTheBaseRoles",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:GetInstanceProfile", "iam:GetPolicy"],
      "Resource": [
        "arn:aws:iam::111122223333:role/omnifile-real-base/*",
        "arn:aws:iam::111122223333:instance-profile/omnifile-real-base/*",
        "arn:aws:iam::111122223333:policy/omnifile-real-base/*"
      ]
    },
    {
      "Sid": "IamPassTheBatchRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real-base/omnifile-real-batch-ops"
    },
    {
      "Sid": "IamPassTheProbeRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real-base/omnifile-real-probe",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "IamEdgeRolesOnlyUnderTheEdgeBoundary",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real/*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::111122223333:policy/omnifile-real-base/omnifile-real-edge-boundary",
          "aws:RequestTag/omnifile-harness": "tests-real"
        },
        "StringLike": {"aws:RequestTag/omnifile-run": "rr-*"}
      }
    },
    {
      "Sid": "IamEdgeRolesTaggedAtCreate",
      "Effect": "Allow",
      "Action": "iam:TagRole",
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real/*",
      "Condition": {"StringEquals": {"aws:RequestTag/omnifile-harness": "tests-real"}}
    },
    {
      "Sid": "IamEdgeRolesChangedOnlyUnderTheEdgeBoundary",
      "Effect": "Allow",
      "Action": ["iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:DeleteRole"],
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real/*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::111122223333:policy/omnifile-real-base/omnifile-real-edge-boundary"
        }
      }
    },
    {
      "Sid": "IamEdgeRolesRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real/*"
    },
    {
      "Sid": "IamPassEdgeRolesToRolesAnywhereOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/omnifile-real/*",
      "Condition": {"StringEquals": {"iam:PassedToService": "rolesanywhere.amazonaws.com"}}
    },
    {
      "Sid": "IamList",
      "Effect": "Allow",
      "Action": ["iam:ListRoles", "iam:ListInstanceProfiles"],
      "Resource": "*"
    },
    {
      "Sid": "DenyAnyRoleWithoutTheEdgeBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::111122223333:policy/omnifile-real-base/omnifile-real-edge-boundary"
        }
      }
    },
    {
      "Sid": "DenyBoundaryChanges",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutUserPermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyChangingTheBaseRolesAndBoundaries",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*"
      ],
      "Resource": [
        "arn:aws:iam::111122223333:role/omnifile-real-base/*",
        "arn:aws:iam::111122223333:instance-profile/omnifile-real-base/*",
        "arn:aws:iam::111122223333:policy/omnifile-real-base/*"
      ]
    },
    {
      "Sid": "SqsCreateTagged",
      "Effect": "Allow",
      "Action": ["sqs:CreateQueue", "sqs:TagQueue"],
      "Resource": "arn:aws:sqs:us-west-2:111122223333:ofreal-rr-*",
      "Condition": {"StringEquals": {"aws:RequestTag/omnifile-harness": "tests-real"}}
    },
    {
      "Sid": "SqsUseTagged",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:DeleteQueue"
      ],
      "Resource": "arn:aws:sqs:us-west-2:111122223333:ofreal-rr-*",
      "Condition": {"StringEquals": {"aws:ResourceTag/omnifile-harness": "tests-real"}}
    },
    {
      "Sid": "SqsList",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*"
    },
    {
      "Sid": "EventsCreateTagged",
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:TagResource"],
      "Resource": "arn:aws:events:us-west-2:111122223333:rule/ofreal-rr-*",
      "Condition": {"StringEquals": {"aws:RequestTag/omnifile-harness": "tests-real"}}
    },
    {
      "Sid": "EventsUseTagged",
      "Effect": "Allow",
      "Action": [
        "events:DescribeRule",
        "events:ListTagsForResource",
        "events:PutTargets",
        "events:ListTargetsByRule",
        "events:RemoveTargets",
        "events:DeleteRule"
      ],
      "Resource": "arn:aws:events:us-west-2:111122223333:rule/ofreal-rr-*",
      "Condition": {"StringEquals": {"aws:ResourceTag/omnifile-harness": "tests-real"}}
    },
    {
      "Sid": "EventsList",
      "Effect": "Allow",
      "Action": "events:ListRules",
      "Resource": "*"
    },
    {
      "Sid": "RolesAnywhereCreateTagged",
      "Effect": "Allow",
      "Action": [
        "rolesanywhere:CreateTrustAnchor",
        "rolesanywhere:CreateProfile",
        "rolesanywhere:ImportCrl",
        "rolesanywhere:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/omnifile-harness": "tests-real"},
        "StringLike": {"aws:RequestTag/omnifile-run": "rr-*"},
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["omnifile-harness", "omnifile-run", "omnifile-expires", "omnifile-trust-anchor"]
        }
      }
    },
    {
      "Sid": "RolesAnywhereManageTagged",
      "Effect": "Allow",
      "Action": [
        "rolesanywhere:GetTrustAnchor",
        "rolesanywhere:GetProfile",
        "rolesanywhere:GetCrl",
        "rolesanywhere:UpdateCrl",
        "rolesanywhere:ListTagsForResource",
        "rolesanywhere:DeleteCrl",
        "rolesanywhere:DeleteProfile",
        "rolesanywhere:DeleteTrustAnchor"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:ResourceTag/omnifile-harness": "tests-real"},
        "StringLike": {"aws:ResourceTag/omnifile-run": "rr-*"}
      }
    },
    {
      "Sid": "RolesAnywhereList",
      "Effect": "Allow",
      "Action": [
        "rolesanywhere:ListTrustAnchors",
        "rolesanywhere:ListProfiles",
        "rolesanywhere:ListCrls"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOmnifileTagsOnEc2ExceptAtCreate",
      "Effect": "Deny",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringLike": {"aws:TagKeys": "omnifile-*"},
        "StringNotEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVpc",
            "CreateSubnet",
            "CreateSecurityGroup",
            "CreateVpcEndpoint"
          ]
        }
      }
    },
    {
      "Sid": "DenyOmnifileTagsAddedToExistingResources",
      "Effect": "Deny",
      "Action": [
        "ssm:AddTagsToResource",
        "tag:TagResources",
        "iam:TagInstanceProfile",
        "iam:TagPolicy",
        "iam:TagUser"
      ],
      "Resource": "*",
      "Condition": {"ForAnyValue:StringLike": {"aws:TagKeys": "omnifile-*"}}
    },
    {
      "Sid": "DenyOmnifileTagsOnQueuesThatArentTheRuns",
      "Effect": "Deny",
      "Action": "sqs:TagQueue",
      "NotResource": "arn:aws:sqs:us-west-2:111122223333:ofreal-rr-*",
      "Condition": {"ForAnyValue:StringLike": {"aws:TagKeys": "omnifile-*"}}
    },
    {
      "Sid": "DenyOmnifileTagsOnRulesThatArentTheRuns",
      "Effect": "Deny",
      "Action": "events:TagResource",
      "NotResource": "arn:aws:events:us-west-2:111122223333:rule/ofreal-rr-*",
      "Condition": {"ForAnyValue:StringLike": {"aws:TagKeys": "omnifile-*"}}
    },
    {
      "Sid": "DenyOmnifileTagsOnRolesThatArentTheRuns",
      "Effect": "Deny",
      "Action": "iam:TagRole",
      "NotResource": "arn:aws:iam::111122223333:role/omnifile-real/*",
      "Condition": {"ForAnyValue:StringLike": {"aws:TagKeys": "omnifile-*"}}
    },
    {
      "Sid": "DenyRemovingOmnifileTags",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteTags",
        "rolesanywhere:UntagResource",
        "sqs:UntagQueue",
        "events:UntagResource",
        "iam:UntagRole",
        "iam:UntagInstanceProfile",
        "ssm:RemoveTagsFromResource",
        "tag:UntagResources"
      ],
      "Resource": "*",
      "Condition": {"ForAnyValue:StringLike": {"aws:TagKeys": "omnifile-*"}}
    },
    {
      "Sid": "SsmRunShellScriptOnTheRunsProbeOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-west-2:111122223333:instance/*",
      "Condition": {
        "StringEquals": {"ssm:resourceTag/omnifile-harness": "tests-real"},
        "StringLike": {"ssm:resourceTag/omnifile-run": "rr-*"}
      }
    },
    {
      "Sid": "SsmRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-west-2::document/AWS-RunShellScript"
    },
    {
      "Sid": "SsmCommandResults",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ssm:DescribeInstanceInformation"],
      "Resource": "*"
    },
    {
      "Sid": "SsmPublicAmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-west-2::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "TaggingProof",
      "Effect": "Allow",
      "Action": "tag:GetResources",
      "Resource": "*"
    },
    {
      "Sid": "KmsThroughS3ForTheRunsBucketsOnly",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"kms:ViaService": "s3.us-west-2.amazonaws.com"},
        "StringLike": {"kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::ofreal-rr-*"}
      }
    },
    {
      "Sid": "KmsDescribeThroughS3",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "*",
      "Condition": {"StringEquals": {"kms:ViaService": "s3.us-west-2.amazonaws.com"}}
    }
  ]
}
