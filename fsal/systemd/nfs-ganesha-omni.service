#
# NFS-Ganesha with FSAL_OMNI, as the appliance runs it (decision 26: Ubuntu
# 26.04). Installed by the integration track (docs/milestones/M1.md); the
# capability set below is the one fsal/tests/t_caps.sh runs ganesha.nfsd
# with, so the FSAL tests prove what this unit grants.
#
# CAP_SYS_ADMIN is load-bearing: FSAL_OMNI reads the trusted.omnifile marker,
# and trusted.* xattrs need it. Without it every marker read answers "no such
# attribute", which would make every stub look like an ordinary file whose
# holes read as zeros. FSAL_OMNI therefore fails every regular-file read and
# write closed when it lacks CAP_SYS_ADMIN, and logs CRIT at export creation
# (docs/contracts/fsal-socket.md section 8).

[Unit]
Description=NFS-Ganesha with FSAL_OMNI (OmniFile Gateway)
Documentation=file:///usr/share/doc/omnifile/fsal-socket.md
# Nothing serves the volume without the edge daemon's armed fanotify guard
# (filer spike, "What the build must do", SMB guard item 2). The daemon unit
# uses RestartMode=direct, so its own crash and restart do not stop Ganesha:
# FSAL_OMNI fails closed while the daemon socket is gone.
Requires=omnifile-edge.service
BindsTo=omnifile-edge.service
After=omnifile-edge.service network-online.target rpcbind.socket
Wants=network-online.target rpcbind.socket

[Service]
Type=simple
ExecStart=/opt/ganesha/bin/ganesha.nfsd -F -L STDOUT -f /etc/ganesha/ganesha.conf -N NIV_EVENT
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
User=root
LimitNOFILE=1048576

# The capability set: what Ganesha + FSAL_VFS + FSAL_OMNI need, nothing more.
#   CAP_SYS_ADMIN         trusted.omnifile markers (FSAL_OMNI)
#   CAP_DAC_READ_SEARCH   open_by_handle_at / name_to_handle_at (FSAL_VFS, FSAL_OMNI)
#   CAP_DAC_OVERRIDE, CAP_FOWNER, CAP_FSETID, CAP_CHOWN, CAP_MKNOD
#                         acting on files for any NFS user (FSAL_VFS)
#   CAP_SETUID, CAP_SETGID  per-request fs credentials (setfsuid/setfsgid)
#   CAP_NET_BIND_SERVICE  port 2049 and the privileged MOUNT/NLM ports
#   CAP_LEASE             NFSv4 delegations
#   CAP_SYS_RESOURCE      present so Ganesha can drop it itself for quotas
#                         (MainNFSD/nfs_init.c lower_my_caps)
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_CHOWN CAP_MKNOD CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE CAP_LEASE CAP_SYS_RESOURCE
AmbientCapabilities=
NoNewPrivileges=yes
# No filesystem sandboxing (ProtectSystem=, PrivateTmp=): exports and their
# open_by_handle_at mount fds must see the real mount tree, and the M1 tests
# do not cover a sandboxed namespace.
RuntimeDirectory=ganesha
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
