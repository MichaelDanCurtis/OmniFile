# OmniFile service image (`omnifile-service`). The `api`, `enrol` and `worker` container apps and the
# verifier job all run it, each with its own command: deploy/azure/main.bicep `appCommands`, which
# replaces this ENTRYPOINT and CMD (control-api.md section 2).
#
#   Build:  deploy/images/build.sh --only service (linux/amd64; digest in images.lock.json),
#           or from service/: podman build -f Containerfile.api -t omnifile-service .
#   Run:    podman run omnifile-service                         (api, the CMD below)
#           podman run omnifile-service omnifile_service.enrol  (or omnifile_service.worker)
#
# api terminates mutual TLS itself by default (OMNIFILE_API_CLIENT_AUTH=direct_tls on :8443, behind a
# TCP ingress; threat model T5), with a plain-HTTP health listener on 127.0.0.1:8080 for the
# HEALTHCHECK. enrol listens on plain HTTP :8080 behind its HTTP ingress. The worker has no port, so
# the HEALTHCHECK doesn't apply to it (Container Apps doesn't use it). Every setting is in
# src/omnifile_service/*/__main__.py. Two stages, as for the relay: uv resolves the locked
# dependencies into a venv; the runtime stage copies only that venv onto python:3.12-slim and runs as
# an unprivileged user.

# Base images are pinned by digest (multi-arch index); bump deliberately, together with relay/.
FROM ghcr.io/astral-sh/uv:0.9@sha256:538e0b39736e7feae937a65983e49d2ab75e1559d35041f9878b7b7e51de91e4 AS uv

FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d
RUN groupadd --system --gid 10001 omnifile \
 && useradd --system --uid 10001 --gid omnifile --no-create-home --shell /usr/sbin/nologin omnifile
COPY --from=build --chown=root:root /app/.venv /app/.venv
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080
USER 10001:10001
EXPOSE 8080
# Works with a read-only root filesystem; nothing is written at runtime.
HEALTHCHECK --interval=30s --timeout=3s CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status == 200 else 1)"]
ENTRYPOINT ["python", "-m"]
CMD ["omnifile_service.api"]
