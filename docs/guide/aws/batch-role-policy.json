{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestoreAndChecksumTheSourceObjects",
      "Effect": "Allow",
      "Action": ["s3:RestoreObject", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::SOURCE_BUCKET/*"]
    },
    {
      "Sid": "ReadTheManifestsWriteTheReports",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": "arn:aws:s3:::OPS_BUCKET/omnifile/*"
    },
    {
      "Sid": "SourceIsReadOnly",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:PutObjectAcl"
      ],
      "Resource": ["arn:aws:s3:::SOURCE_BUCKET/*"]
    }
  ]
}
