{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheServiceManagedIdentitiesByWebIdentity",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/sts.windows.net/11111111-1111-1111-1111-111111111111/"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "sts.windows.net/11111111-1111-1111-1111-111111111111/:aud": "api://22222222-2222-2222-2222-222222222222",
          "sts.windows.net/11111111-1111-1111-1111-111111111111/:sub": [
            "33333333-3333-3333-3333-333333333333",
            "44444444-4444-4444-4444-444444444444"
          ]
        }
      }
    }
  ]
}
