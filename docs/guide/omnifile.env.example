# OmniFile Gateway: your values for the customer guide (docs/guide/README.md).
#
# Copy this file to omnifile.env in the root of the release folder (step 4) and fill in every
# value. Every command in the guide reads it first. Keep omnifile.env out of version control:
# it holds names and addresses, never a password. The guide asks for passwords when it needs
# them and never stores them.
#
# Values written by the guide's own steps (deployment outputs, certificates, ids) go to
# omnifile.state.env, next to this file. Don't edit that one by hand.
#
# What the guide asks you to type, and never writes down (steps marked input= or <secret:...>):
# input: OMNI_AD_JOIN_PASSWORD     the join account's password (the setup wizard, step 51)
# input: OMNI_ENROL_CODE           the one-time enrolment code from the portal (step 54)
# input: OMNI_TEST_USER_PASSWORD   the test user's AD password (step 60)
# input: OMNI_OTHER_USER_PASSWORD  the other user's AD password (step 61)

# ---- Azure ----------------------------------------------------------------------------------
# The subscription and Entra tenant the service is deployed in.
export OMNI_SUBSCRIPTION_ID='00000000-0000-0000-0000-000000000000'
export OMNI_TENANT_ID='00000000-0000-0000-0000-000000000000'
# The Azure region, e.g. westeurope, eastus2. It must offer Container Apps workload profiles,
# PostgreSQL Flexible Server and zone-redundant storage.
export OMNI_LOCATION='westeurope'
# The deployment's size (section 5): standard, or small for a site with a few edges (a smaller
# database server and smaller apps, the same private networking). Empty means standard.
export OMNI_DEPLOYMENT_SIZE='standard'
# A new, empty resource group for the service.
export OMNI_RG='rg-omnifile'
# 2 to 8 lowercase letters or digits, used in every resource name (Bicep namePrefix).
export OMNI_PREFIX='omni'
# The OmniFile release you deploy, from the release notes, e.g. 1.2.0.
export OMNI_RELEASE='1.2.0'
# The registry OmniFile publishes the service images to (from the release notes).
export OMNI_SOURCE_REGISTRY='registry.example'
# Your Azure Container Registry, the name only (without .azurecr.io). It must exist.
export OMNI_ACR='contosoomnifile'
# The Entra group that administers the database. You must be a member of it. Spaces are fine; quotes
# and backslashes are not.
export OMNI_PG_ADMIN_GROUP='OmniFile-DB-Admins'
# Networks, comma-separated CIDRs, no spaces.
#   OMNI_EDGE_CIDRS: where the edge filers are (they enrol from there).
#   OMNI_USER_CIDRS: where the people who use the portal are (and each API client's, if used).
#   OMNI_ADMIN_CIDRS: where this workstation is: it reaches the portal and enrol, and the database to
#   set it up.
# None of them may overlap the relay subnet (OMNI_SUBNET_RELAY), and none may be 0.0.0.0/0: the
# deployment refuses both (threat model T1).
export OMNI_EDGE_CIDRS='10.20.0.0/16'
export OMNI_USER_CIDRS='10.30.0.0/16'
export OMNI_ADMIN_CIDRS='10.40.0.0/24'
# The service's address space in Azure. Change these only if they collide with your networks.
export OMNI_VNET_PREFIX='10.60.0.0/16'
export OMNI_SUBNET_CAE='10.60.0.0/26'
export OMNI_SUBNET_RELAY='10.60.0.64/27'
export OMNI_SUBNET_PG='10.60.0.96/27'
export OMNI_SUBNET_PE='10.60.0.128/27'
# The hub virtual network your ExpressRoute or VPN gateway is in (its full resource id). The
# guide peers the service's network to it.
export OMNI_HUB_VNET_ID='/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-hub/providers/Microsoft.Network/virtualNetworks/vnet-hub'
# Test runs only, never for a client: 1 lets step 20 peer with a hub that has no gateway (a stand-in
# hub in a test subscription). Leave it empty.
export OMNI_TEST_HUB_NO_GATEWAY=''
# Where the private DNS zones live. Empty: the guide creates them in OMNI_RG. If your hub
# already has privatelink.blob.core.windows.net and privatelink.vaultcore.azure.net, name
# that resource group here and the guide uses them.
export OMNI_DNS_ZONE_RG=''
# The inbound IP address of your Azure DNS resolver (a DNS Private Resolver inbound
# endpoint, or a DNS server in the hub). Your on-premises DNS servers forward to it.
export OMNI_DNS_RESOLVER_IP='10.0.0.4'
# The mailbox the service sends email from when Teams can't reach someone.
export OMNI_NOTIFY_SENDER='omnifile@contoso.example'
# Optional: an action group for alerts (full resource id). Empty: alerts show in Azure only.
export OMNI_ALERT_ACTION_GROUP_ID=''

# ---- Active Directory ------------------------------------------------------------------------
# The AD DNS domain, its short (pre-Windows 2000) name, and an account that may join computers.
export OMNI_AD_DOMAIN='corp.example'
export OMNI_AD_WORKGROUP='CORP'
export OMNI_AD_JOIN_USER='svc-omnifile-join'
# The OU for the filer's computer account. Empty: the domain's default (CN=Computers).
export OMNI_AD_JOIN_OU=''
# The AD group whose members administer the filer (sudo and ssh), and one of its members.
export OMNI_AD_ADMIN_GROUP='OmniFile-Admins'
export OMNI_AD_ADMIN_USER='alice.admin'
# Who holds the portal's roles (section 1.5). groups: each role goes to an AD group, and access follows
# group membership; this needs Entra ID P1. people: ArchiveAdmin and DataSteward go to the people named
# below, and every AD user in your tenant is a User without an assignment; this works on Entra ID Free.
# Empty means groups.
export OMNI_ROLE_HOLDERS='groups'
# With groups: the AD groups that get the portal's roles (synced to Entra by Entra Connect).
export OMNI_GROUP_ARCHIVEADMIN='OmniFile-ArchiveAdmins'
export OMNI_GROUP_DATASTEWARD='OmniFile-DataStewards'
export OMNI_GROUP_USER='OmniFile-Users'
# With people: the sign-in names of the ArchiveAdmins (at least one) and the DataStewards (may be
# empty), separated by spaces.
export OMNI_PEOPLE_ARCHIVEADMIN=''
export OMNI_PEOPLE_DATASTEWARD=''
# The first uidNumber and gidNumber to hand out when your AD has no POSIX attributes yet
# (section 1.4). Both must be inside 10000-999999 and above every number already in use.
export OMNI_FIRST_UID='20000'
export OMNI_FIRST_GID='30000'

# ---- The edge filer --------------------------------------------------------------------------
# How the portal shows it (lowercase letters, digits and hyphens).
export OMNI_EDGE_NAME='houston-1'
# Its name on the network: at most 15 letters, digits or hyphens.
export OMNI_EDGE_HOSTNAME='omnifile-hou1'
# Its fixed address with prefix length, its gateway, and DNS servers (your domain
# controllers, separated by spaces).
export OMNI_EDGE_ADDRESS='10.20.1.10/24'
export OMNI_EDGE_GATEWAY='10.20.1.1'
export OMNI_EDGE_DNS='10.20.0.10 10.20.0.11'
# When it may restart to apply an update (a systemd calendar time).
export OMNI_EDGE_RESTART_WINDOW='Sun *-*-* 03:00'
# The size of its data disk, in GB: the local cache the shares live on.
export OMNI_DATA_DISK_GB='2048'
# KVM hosts only: the bridge the filer's network adapter joins.
export OMNI_KVM_BRIDGE='br0'

# ---- The first share and the checks ---------------------------------------------------------
# The share's name: the Windows share name (\\filer\name) and the NFS path (filer:/name).
export OMNI_SHARE='projects'
# Its AD groups.
export OMNI_SHARE_OWNERS='Proj-Owners'
export OMNI_SHARE_WRITERS='Proj-Writers'
export OMNI_SHARE_READERS='Proj-Readers'
# The Linux hosts or subnets trusted to mount it over NFS without Kerberos (sec=sys),
# comma-separated. Include the Linux test client.
export OMNI_NFS_CLIENTS='10.20.5.0/24'
# A test user in the Writers group, and its uidNumber. And a user in none of the share's groups.
export OMNI_TEST_USER='bob.writer'
export OMNI_TEST_UID='20011'
export OMNI_OTHER_USER='carol.nobody'
# The gidNumber of Domain Users (every user's primary group in AD).
export OMNI_DOMAIN_USERS_GID='10000'
# Where the Linux test client mounts the share.
export OMNI_CLIENT_MOUNT='/mnt/omnifile'

# ---- Amazon S3 (migration clients only, section 17) ------------------------------------------
# Leave these as they are if no data is coming from S3.
export OMNI_AWS_ACCOUNT_ID=''
export OMNI_AWS_REGION=''
export OMNI_AWS_VPC_ID=''
# Subnets (comma-separated) and the security group for the interface endpoints.
export OMNI_AWS_SUBNET_IDS=''
export OMNI_AWS_SG_ID=''
# The buckets being migrated (comma-separated), and a bucket OmniFile may write its own work
# files to (staged recalls, Batch Operations manifests and reports). Never a source bucket.
export OMNI_AWS_SOURCE_BUCKETS=''
export OMNI_AWS_OPS_BUCKET=''

# ---- API clients (section 18) -----------------------------------------------------------------
# One application that calls the API (repeat section 18 for each, with its values). Empty: none.
#   OMNI_API_CLIENT_APP_ID: its application (client) id in Entra
#   OMNI_API_CLIENT_NAME: the name the portal shows
#   OMNI_API_CLIENT_SCOPES: comma-separated, from Policy.Propose, Recall.Request, Archive.Read, Archive.Adopt
#   OMNI_API_CLIENT_OWNER: the sign-in name of the person answerable for it
export OMNI_API_CLIENT_APP_ID=''
export OMNI_API_CLIENT_NAME=''
export OMNI_API_CLIENT_SCOPES=''
export OMNI_API_CLIENT_OWNER=''

# ---- Test runs only ------------------------------------------------------------------------------
# Never set these for a client: they make a cheaper, shorter-lived deployment for the real-cloud tests
# (tests/real). Empty means the client default. check-env.sh accepts each only empty or test-shaped.
# OMNI_TEST_RUN_ID: the run's id; with it, every resource is tagged omnifile-run, omnifile-expires and omnifile-harness=tests-real
export OMNI_TEST_RUN_ID=''
# OMNI_TEST_RUN_EXPIRES: when the run's resources expire (UTC, e.g. 2026-11-04T18:00Z)
export OMNI_TEST_RUN_EXPIRES=''
# OMNI_TEST_PG_SKU_TIER: Burstable
export OMNI_TEST_PG_SKU_TIER=''
# OMNI_TEST_PG_SKU_NAME: a Burstable size, e.g. Standard_B2ms
export OMNI_TEST_PG_SKU_NAME=''
# OMNI_TEST_PG_STORAGE_GB: 32
export OMNI_TEST_PG_STORAGE_GB=''
# OMNI_TEST_KV_PURGE_PROTECTION: false: the vault can be purged at teardown
export OMNI_TEST_KV_PURGE_PROTECTION=''
# OMNI_TEST_KV_SOFT_DELETE_DAYS: 7 to 90
export OMNI_TEST_KV_SOFT_DELETE_DAYS=''
# OMNI_TEST_API_MIN_REPLICAS: 1
export OMNI_TEST_API_MIN_REPLICAS=''
# OMNI_TEST_API_MAX_REPLICAS: 2
export OMNI_TEST_API_MAX_REPLICAS=''
# OMNI_TEST_WORKER_MAX_REPLICAS: 1
export OMNI_TEST_WORKER_MAX_REPLICAS=''
# OMNI_TEST_WORM_RETENTION_DAYS: 1: adds the WORM share tst, its retention unlocked
export OMNI_TEST_WORM_RETENTION_DAYS=''
# OMNI_TEST_LOCK_WORM: false: no CanNotDelete lock on the WORM account
export OMNI_TEST_LOCK_WORM=''
# OMNI_TEST_BLOB_SOFT_DELETE_DAYS: 1 to 7
export OMNI_TEST_BLOB_SOFT_DELETE_DAYS=''
# OMNI_TEST_ALERTS: false
export OMNI_TEST_ALERTS=''
# OMNI_AWS_NAME_SUFFIX: the run id (same shape as OMNI_TEST_RUN_ID); section 17's AWS names (the roles,
# the trust anchor, the profile, the event queue and rule, the endpoints' Name tags) end in -<suffix>
export OMNI_AWS_NAME_SUFFIX=''
